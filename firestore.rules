rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net - secure but fully functional for authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // 2. Collection specific overrides
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /premium_subscribers/{userId} {
      allow read, write: if request.auth != null;
    }

    match /proposals/{proposalId} {
      allow read: if true; // Public access for shared cards
      allow write: if request.auth != null;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }

    match /update_logs/{logId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /templates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /crush_letters/{letterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /soul_connections/{connectionId} {
      allow read, write: if request.auth != null;
    }

    match /lover_game_rooms/{roomId} {
      allow read, write: if request.auth != null;
    }

    match /ai_companion_conversations/{userId} {
      allow read, write: if request.auth != null;
    }

    match /user_templates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
